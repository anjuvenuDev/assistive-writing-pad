# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/

# Local environment
.env
.env.*

# Model artifacts are documented but not committed by default.
models/*
!models/README.md
!models/adapters/
models/adapters/*
!models/adapters/penpal-small/
!models/adapters/penpal-small/adapter.json
!models/adapters/penpal-small/adapter.safetensors
!models/adapters/penpal-small-v2/
!models/adapters/penpal-small-v2/**

# Dataset drops can be large; commit only curated examples.
data/*
!data/examples/
!data/examples/**
!data/evaluation/
!data/evaluation/coverage_report.json
!data/evaluation/correction_cases.jsonl
!data/evaluation/correction_report.json
!data/evaluation/end_to_end_cases.jsonl
!data/evaluation/end_to_end_report.json
!data/evaluation/evaluation_suite_report.json
!data/evaluation/penpal_end_to_end_cases.jsonl
!data/evaluation/penpal_end_to_end_report.json
!data/evaluation/readiness_report.json
!data/evaluation/recognition_cases.jsonl
!data/evaluation/recognition_report.json
!data/training/
data/training/*
!data/training/penpal/
!data/training/penpal/*.json
!data/training/penpal/*.jsonl

# Local alternate git directory used in this sandbox.
.git-local/
